# Development image used by docker-compose (hot reload + mounted source).
# The production build lives in ./Dockerfile (distroless, generated by fastapi-mvc).
# pyproject.toml stays the canonical dependency list; the runtime deps below
# mirror its [tool.poetry.dependencies] main group for a fast, reliable dev build.
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

RUN pip install \
    "fastapi~=0.98.0" \
    "uvicorn[standard]~=0.22.0" \
    "gunicorn~=20.1.0" \
    "click~=8.1.3" \
    "redis~=4.5.5" \
    "sqlalchemy~=2.0.0" \
    "psycopg2-binary~=2.9.0"

# Test tooling, mirroring [tool.poetry.group.dev.dependencies]. It belongs in
# this image: `docker compose exec backend python -m pytest` is the documented
# way to run the suite, and a freshly built container has to answer it.
RUN pip install     "pytest~=7.4.0"     "pytest-cov~=4.0.0"     "pytest-asyncio~=0.21.0"

COPY . .

EXPOSE 8000

# get_application() is the FastAPI factory defined in app/asgi.py.
CMD ["uvicorn", "api_container.app.asgi:get_application", \
     "--factory", "--host", "0.0.0.0", "--port", "8000", "--reload"]
